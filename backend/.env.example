# Backend Environment Variables

# Server
PORT=3001
NODE_ENV=development

# Frontend (allowed origins for CORS)
# Use FRONTEND_URLS for multiple comma-separated origins, or FRONTEND_URL for a single origin
FRONTEND_URLS=http://localhost:3000
# FRONTEND_URL=https://smartmoneycalender.com (example for production)

# Database
MONGODB_URI=mongodb://localhost:27017/smart-money-calendar

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Payment Providers
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

CRYPTOMUS_MERCHANT_UUID=
CRYPTOMUS_API_KEY=

# Email Service
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# External APIs
TRADING_ECONOMICS_API_KEY=
FOREX_FACTORY_API_KEY=

# Groq AI
GROQ_API_KEY=

# Google Gemini / GenAI rate limiter defaults
# Set GENAI_RPM_LIMIT to increase allowed requests per minute (default 30)
# Set GENAI_MIN_DELAY_MS to change minimum delay between requests in ms (default 2000)
GENAI_RPM_LIMIT=30
GENAI_MIN_DELAY_MS=2000
